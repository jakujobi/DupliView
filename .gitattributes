# Auto detect text files and normalize common project formats.
* text=auto

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

*.md text eol=lf
*.txt text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
.gitkeep text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.sha256 text eol=lf
